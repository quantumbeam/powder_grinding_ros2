<?xml version="1.0"?>
<!--
  SRDF for COBOTTA with pestle and spatula
  (grinding_robot_description/urdf/cobotta/cobotta_with_pestle.urdf).
  Based on ROS1 grinding_descriptions/config/cobotta/cobotta.srdf.
  The disabled collision pairs were generated by
  "ros2 run moveit_setup_assistant collisions_updater" with the options
  urdf=cobotta_with_pestle.urdf, srdf=cobotta.srdf, keep, trials=50000.
  Re-run it when the meshes of the arm or the tools change.
-->
<robot name="cobotta">
  <!-- The chain ends at pestle_tip so that the RViz interactive marker and IK target the pestle tip. -->
  <group name="arm">
    <chain base_link="base_link" tip_link="pestle_tip"/>
  </group>

  <group_state name="home" group="arm">
    <joint name="joint_1" value="0"/>
    <joint name="joint_2" value="0"/>
    <joint name="joint_3" value="1.57"/>
    <joint name="joint_4" value="0"/>
    <joint name="joint_5" value="0"/>
    <joint name="joint_6" value="0"/>
  </group_state>

  <disable_collisions link1="J1" link2="J2" reason="Adjacent"/>
  <disable_collisions link1="J1" link2="J3" reason="Never"/>
  <disable_collisions link1="J1" link2="J4" reason="Never"/>
  <disable_collisions link1="J1" link2="base_link" reason="Adjacent"/>
  <disable_collisions link1="J2" link2="J3" reason="Adjacent"/>
  <disable_collisions link1="J2" link2="J4" reason="Never"/>
  <disable_collisions link1="J2" link2="J5" reason="Never"/>
  <disable_collisions link1="J2" link2="J6" reason="Never"/>
  <disable_collisions link1="J2" link2="base_link" reason="Never"/>
  <disable_collisions link1="J3" link2="J4" reason="Adjacent"/>
  <disable_collisions link1="J3" link2="J5" reason="Never"/>
  <disable_collisions link1="J3" link2="J6" reason="Never"/>
  <disable_collisions link1="J3" link2="base_link" reason="Never"/>
  <disable_collisions link1="J3" link2="pestle" reason="Never"/>
  <disable_collisions link1="J4" link2="J5" reason="Adjacent"/>
  <disable_collisions link1="J4" link2="J6" reason="Never"/>
  <disable_collisions link1="J4" link2="pestle" reason="Never"/>
  <disable_collisions link1="J4" link2="spatula" reason="Never"/>
  <disable_collisions link1="J5" link2="J6" reason="Adjacent"/>
  <disable_collisions link1="J5" link2="pestle" reason="Never"/>
  <disable_collisions link1="J5" link2="spatula" reason="Never"/>
  <disable_collisions link1="J6" link2="pestle" reason="Adjacent"/>
  <disable_collisions link1="J6" link2="spatula" reason="Adjacent"/>
  <disable_collisions link1="pestle" link2="spatula" reason="Never"/>
</robot>
